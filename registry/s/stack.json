{
 "schemaVersion": 1,
 "name": "stack",
 "version": "0.1.0",
 "source": "git+https://github.com/Coditary/rqp-plugin-stack.git@main",
 "description": "ReqPack Lua wrapper plugin for Haskell Stack installs, local Stack projects, and Hackage package queries",
 "role": "package-manager",
 "capabilities": [
  "package-install",
  "package-remove",
  "package-update",
  "package-query",
  "local-project-install"
 ],
 "ecosystemScopes": [
  "hackage",
  "haskell",
  "stack"
 ],
 "writeScopes": [
  "user-home-subpath:.cache/reqpack/stack",
  "project-subpath:.stack-work"
 ],
 "networkScopes": [
  "hackage.haskell.org"
 ],
 "privilegeLevel": "none",
 "scriptSha256": "",
 "bootstrapSha256": "",
 "aliases": []
}

{
  "schemaVersion": 1,
  "name": "tempify",
  "version": "0.1.3",
  "source": "git+https://github.com/Coditary/rqp-plugin-tempify.git@main",
  "description": "ReqPack package manager for Tempify templates (catalog sync, install, search).",
  "role": "package-manager",
  "capabilities": ["exec", "network"],
  "ecosystemScopes": ["tempify"],
  "writeScopes": [
    { "kind": "user-home-subpath", "value": ".local/share/tempify" }
  ],
  "networkScopes": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "privilegeLevel": "user",
  "scriptSha256": "",
  "bootstrapSha256": "",
  "aliases": []
}

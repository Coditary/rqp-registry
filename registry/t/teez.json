{
  "schemaVersion": 1,
  "name": "teez",
  "version": "0.1.0",
  "source": "git+https://github.com/Coditary/rqp-plugin-teez.git@main",
  "description": "ReqPack package manager for optional teez runner plugins (vitest, …).",
  "role": "package-manager",
  "capabilities": ["exec", "network"],
  "ecosystemScopes": ["teez"],
  "writeScopes": [
    { "kind": "user-home-subpath", "value": ".cache/teez" },
    { "kind": "user-home-subpath", "value": ".local/share/teez/plugins" }
  ],
  "networkScopes": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "privilegeLevel": "user",
  "scriptSha256": "",
  "bootstrapSha256": "",
  "aliases": []
}

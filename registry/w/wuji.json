{
  "schemaVersion": 1,
  "name": "wuji",
  "version": "0.1.0",
  "source": "git+https://github.com/Coditary/rqp-plugin-wuji.git@main",
  "description": "ReqPack package manager for Wuji AI driver plugins.",
  "role": "package-manager",
  "capabilities": ["exec", "network"],
  "ecosystemScopes": ["wuji"],
  "writeScopes": [
    { "kind": "user-home-subpath", "value": ".cache/wuji" },
    { "kind": "user-home-subpath", "value": ".local/share/wuji/plugins" },
    { "kind": "user-home-subpath", "value": ".local/share/wuji/drivers" }
  ],
  "networkScopes": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "privilegeLevel": "user",
  "scriptSha256": "",
  "bootstrapSha256": "",
  "aliases": []
}

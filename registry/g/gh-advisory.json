{
  "schemaVersion": 1,
  "name": "gh-advisory",
  "version": "0.1.0",
  "source": "git+https://github.com/Coditary/ReqPack.git@main",
  "description": "ReqPack security-provider plugin for importing GitHub Advisory Database advisories into ReqPack shared vulnerability indexes",
  "role": "security-provider",
  "capabilities": ["sync"],
  "ecosystemScopes": ["all-github-advisory-ecosystems"],
  "writeScopes": [],
  "networkScopes": [
    { "host": "codeload.github.com", "scheme": "https", "pathPrefix": "/github/advisory-database/" },
    { "host": "github.com", "scheme": "https", "pathPrefix": "/github/advisory-database/" }
  ],
  "privilegeLevel": "none",
  "scriptSha256": "",
  "bootstrapSha256": "",
  "aliases": []
}

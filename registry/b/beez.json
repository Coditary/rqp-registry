{
  "schemaVersion": 1,
  "name": "beez",
  "version": "1.0.5",
  "source": "git+https://github.com/Coditary/beez-registry.git?ref=main",
  "description": "ReqPack package manager for Beez workflow plugins (.rqp packages, catalog, and git fallbacks).",
  "role": "package-manager",
  "capabilities": ["exec", "network"],
  "ecosystemScopes": ["beez"],
  "writeScopes": [
    { "kind": "user-home-subpath", "value": ".cache/beez" }
  ],
  "networkScopes": [
    "github.com",
    "raw.githubusercontent.com",
    "api.github.com"
  ],
  "privilegeLevel": "user",
  "scriptSha256": "",
  "bootstrapSha256": "",
  "aliases": []
}
